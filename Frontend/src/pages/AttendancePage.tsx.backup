/**
 * AttendancePage  —  /programs/:id/attendance  (admin, local_admin role)
 *
 * REDESIGNED LAYOUT (Based on TraineeAttendancePage):
 *   1. Header Section:
 *      - Greeting with program name
 *      - Date display
 *      - Responsive layout for mobile/tablet/desktop
 *   
 *   2. Main Content Grid (Desktop Layout):
 *      - Left Sidebar (25-30%): Filters & Navigation
 *        - Date picker for day view
 *        - Summary stats (Present, Late, Absent, Rate %)
 *        - View mode toggle (card/table)
 *        - Search box
 *      
 *      - Right Calendar (70-75%): Attendance Records
 *        - Calendar month view with attendance dots
 *        - Day view with Morning/Afternoon sections
 *        - Records or tables based on selected view
 *
 *   3. Responsive Behavior:
 *      - Desktop (1024px+): Side-by-side layout
 *      - Tablet (768px): Stack vertically
 *      - Mobile (320px): Full-width, collapsible panels
 */
import { useState, useEffect, useCallback } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import DashboardLayout from '../components/DashboardLayout';
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Badge } from '../components/ui/badge';
import { Button } from '../components/ui/button';
import { Skeleton } from '../components/ui/skeleton';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '../components/ui/tabs';
import {
  Select, SelectContent, SelectItem, SelectTrigger, SelectValue,
} from '../components/ui/select';
import { Input } from '../components/ui/input';
import { Separator } from '../components/ui/separator';
import {
  ChevronLeft, Calendar, Clock, RefreshCw,
  Loader2, BarChart3, CheckCircle2, XCircle, BookOpen,
  GraduationCap, List, LayoutGrid, MapPin, Camera,
} from 'lucide-react';
import {
  ResponsiveContainer, LineChart, Line, XAxis, YAxis,
  CartesianGrid, Tooltip as ReTooltip, Legend,
  PieChart, Pie, Cell,
} from 'recharts';
import { toast } from 'sonner';
import programService from '../services/programService';
import attendanceService from '../services/attendanceService';
import { toDateString } from '../utils/dateUtils';
import type {
  AdminDashboardData, DayAttendanceData, AttendanceRecord,
  AttendanceSchedule,
} from '../services/attendanceService';
import { useAuth } from '../contexts/AuthContext';
import AttendanceCalendar from '../components/attendance/AttendanceCalendar';
import AttendanceDetailModal from '../components/attendance/AttendanceDetailModal';
import ScheduleFormModal from '../components/attendance/ScheduleFormModal';
import ScheduleOverrideModal from '../components/attendance/ScheduleOverrideModal';
import { getFileUrl } from '../services/api';

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

const PIE_COLORS: Record<string, string> = {
  present: '#22c55e',
  late:    '#f97316',
  absent:  '#ef4444',
  excused: '#a855f7',
  pending: '#3b82f6',
};

const STATUS_BADGE: Record<string, string> = {
  present: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
  late:    'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300',
  absent:  'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300',
  excused: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300',
  pending: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300',
};

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function formatTime(iso?: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}

function exportCSV(rows: AttendanceRecord[], filename: string) {
  const headers = [
    'Trainee', 'Status', 'Morning In', 'Afternoon Out', 'Late (min)', 'GPS', 'Attempt'
  ];
  const lines = rows.map((r) => {
    const trainee = (r.trainee as any);
    const name = trainee ? `${trainee.first_name} ${trainee.last_name}` : r.trainee_id;
    return [
      name, r.status,
      formatTime(r.morning_time_in ?? r.check_in_time),
      formatTime(r.afternoon_time_out ?? r.check_out_time),
      String(r.late_duration_minutes ?? 0),
      r.gps_lat != null ? 'Yes' : 'No',
      String(r.attempt_number ?? 1),
    ].join(',');
  });
  const csv = [headers.join(','), ...lines].join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
}

// ---------------------------------------------------------------------------
// Main component
// ---------------------------------------------------------------------------

export default function AttendancePage() {
  const { id: programId } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const { isAuthReady, hasPermission, user } = useAuth();

  // ── Program data ───────────────────────────────────────────────────────
  const [program,        setProgram]       = useState<any>(null);
  const [programLoading, setProgramLoading] = useState(true);

  // ── Overview tab ──────────────────────────────────────────────────────
  const [dashData,     setDashData]     = useState<AdminDashboardData | null>(null);
  const [dashLoading,  setDashLoading]  = useState(false);
  const [filterStart,  setFilterStart]  = useState('');
  const [filterEnd,    setFilterEnd]    = useState('');
  const [filterStatus, setFilterStatus] = useState('');

  // ── Records tab ───────────────────────────────────────────────────────
  const [calendarMonth,  setCalendarMonth]  = useState<Date>(new Date());
  const [selectedDate,   setSelectedDate]   = useState<string | null>(null);
  const [dayData,        setDayData]        = useState<DayAttendanceData | null>(null);
  const [dayLoading,     setDayLoading]     = useState(false);
  const [viewMode,       setViewMode]       = useState<'card' | 'table'>('card');
  const [searchQuery,    setSearchQuery]    = useState('');
  const [modalRecord,    setModalRecord]    = useState<AttendanceRecord | null>(null);
  const [modalTrainee,   setModalTrainee]   = useState<any>(null);
  const [modalOpen,      setModalOpen]      = useState(false);

  // ── Schedules tab ─────────────────────────────────────────────────────
  const [schedules,       setSchedules]      = useState<AttendanceSchedule[]>([]);
  const [schedulesLoading, setSchedulesLoading] = useState(false);
  const [scheduleFormOpen,   setScheduleFormOpen]   = useState(false);
  const [editingSchedule,    setEditingSchedule]    = useState<AttendanceSchedule | undefined>();
  const [overrideModalOpen,  setOverrideModalOpen]  = useState(false);
  const [overrideScheduleId, setOverrideScheduleId] = useState<string>('');
  const [overrideSchedule,   setOverrideSchedule]   = useState<AttendanceSchedule | undefined>();

  const canOverride = user?.role === 'local_admin';

  // ── Load program ────────────────────────────────────────────────────────
  useEffect(() => {
    if (!programId || !isAuthReady) return;

    if (!hasPermission('canManagePrograms')) {
      toast.error('You do not have permission to view program attendance');
      navigate('/programs', { replace: true });
      return;
    }

    setProgramLoading(true);
    programService.getProgramById(programId)
      .then((prog) => setProgram(prog))
      .catch((err: any) => {
        if (err?.status === 403) {
          toast.error('Access denied');
          navigate('/programs', { replace: true });
          return;
        }
        toast.error('Failed to load program');
      })
      .finally(() => setProgramLoading(false));
  }, [programId, isAuthReady, hasPermission, navigate]);

  // ── Load dashboard data ─────────────────────────────────────────────────
  const loadDashboard = useCallback(async () => {
    if (!programId) return;
    setDashLoading(true);
    try {
      const res = await attendanceService.getAdminDashboard(programId, {
        startDate: filterStart || undefined,
        endDate:   filterEnd   || undefined,
        status:    filterStatus || undefined,
      });
      setDashData(res.data ?? null);
    } catch {
      toast.error('Failed to load dashboard data');
    } finally {
      setDashLoading(false);
    }
  }, [programId, filterStart, filterEnd, filterStatus]);

  useEffect(() => { loadDashboard(); }, [loadDashboard]);

  // ── Load day attendance when a date is selected ─────────────────────────
  useEffect(() => {
    if (!selectedDate || !programId) return;
    setDayLoading(true);
    attendanceService.getDayAttendance(programId, selectedDate)
      .then((res) => setDayData(res.data ?? null))
      .catch(() => toast.error('Failed to load day attendance'))
      .finally(() => setDayLoading(false));
  }, [selectedDate, programId]);

  // ── Load schedules ──────────────────────────────────────────────────────
  const loadSchedules = useCallback(async () => {
    if (!programId) return;
    setSchedulesLoading(true);
    try {
      const res = await attendanceService.getSchedules(programId);
      setSchedules(res.data ?? []);
    } catch {
      // silent
    } finally {
      setSchedulesLoading(false);
    }
  }, [programId]);

  // ── Open detail modal ───────────────────────────────────────────────────
  function openModal(record: AttendanceRecord | null, trainee: any) {
    setModalRecord(record);
    setModalTrainee(trainee);
    setModalOpen(true);
  }

  // ── Filter day records by search ────────────────────────────────────────
  const filteredRecords = (dayData?.records ?? []).filter((r) => {
    if (!searchQuery) return true;
    const trainee = r.trainee as any;
    const name = trainee
      ? `${trainee.first_name} ${trainee.last_name}`.toLowerCase()
      : '';
    return name.includes(searchQuery.toLowerCase());
  });

  const filteredNoRecord = (dayData?.noRecord ?? []).filter((t: any) => {
    if (!searchQuery) return true;
    return `${t.first_name} ${t.last_name}`.toLowerCase().includes(searchQuery.toLowerCase());
  });

  // ── Render ──────────────────────────────────────────────────────────────
  return (
    <DashboardLayout>
      <div className="space-y-6">

        {/* ── Header Section with Program Name ── */}
        <div className="space-y-1">
          <div className="flex items-center gap-2 mb-2">
            <Button variant="ghost" size="icon" onClick={() => navigate('/programs')} className="shrink-0">
              <ChevronLeft className="size-5" />
            </Button>
            <h1 className="text-3xl font-bold">
              Attendance
            </h1>
          </div>
          {programLoading ? (
            <Skeleton className="h-5 w-48" />
          ) : program && (
            <div className="flex flex-wrap gap-2 items-center">
              <span className="font-medium text-base text-foreground">{program.name}</span>
              {program.status === 'active' && (
                <Badge variant="outline" className="text-xs">Active</Badge>
              )}
            </div>
          )}
          <p className="text-xs text-muted-foreground mt-2">
            {new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
          </p>
        </div>

        {/* ── Main Grid Layout: Left Sidebar + Right Content ── */}
        <div className="grid gap-6 lg:grid-cols-4">

          {/* ================================================================
              TAB 1 — OVERVIEW
          ================================================================ */}
          <TabsContent value="overview" className="space-y-5 mt-4">

            {/* Summary cards */}
            {dashLoading ? (
              <div className="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
                {[...Array(6)].map((_, i) => <Skeleton key={i} className="h-24 rounded-xl" />)}
              </div>
            ) : dashData && (
              <div className="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
                {([
                  { label: 'Present Today',  value: dashData.summaryCards.presentToday,  Icon: CheckCircle2, color: 'text-green-600',  bg: 'bg-green-50 dark:bg-green-950/30'  },
                  { label: 'Late Today',     value: dashData.summaryCards.lateToday,     Icon: Clock,        color: 'text-orange-600', bg: 'bg-orange-50 dark:bg-orange-950/30'},
                  { label: 'Absent Today',   value: dashData.summaryCards.absentToday,   Icon: XCircle,      color: 'text-red-600',    bg: 'bg-red-50 dark:bg-red-950/30'      },
                  { label: 'Pending',        value: dashData.summaryCards.pendingCount,  Icon: Loader2,      color: 'text-blue-600',   bg: 'bg-blue-50 dark:bg-blue-950/30'    },
                  { label: 'Excused',        value: dashData.summaryCards.excusedToday,  Icon: BookOpen,     color: 'text-purple-600', bg: 'bg-purple-50 dark:bg-purple-950/30'},
                  { label: 'Rate',           value: `${dashData.summaryCards.attendanceRate}%`, Icon: BarChart3, color: 'text-primary', bg: 'bg-primary/5' },
                ] as any[]).map((s) => (
                  <Card key={s.label} className={`border-0 shadow-sm ${s.bg}`}>
                    <CardContent className="pt-4 pb-3">
                      <div className="flex items-center justify-between mb-1">
                        <p className="text-xs font-medium text-muted-foreground">{s.label}</p>
                        <s.Icon className={`size-4 ${s.color} opacity-60`} />
                      </div>
                      <p className={`text-2xl font-bold ${s.color}`}>{s.value}</p>
                    </CardContent>
                  </Card>
                ))}
              </div>
            )}

            {/* Filters */}
            <Card>
              <CardContent className="pt-4 pb-3">
                <div className="flex flex-wrap gap-3 items-end">
                  <div className="flex flex-col gap-1">
                    <label className="text-xs text-muted-foreground">From</label>
                    <input type="date" value={filterStart} onChange={(e) => setFilterStart(e.target.value)}
                      className="h-9 rounded-md border border-input bg-background px-3 text-sm" />
                  </div>
                  <div className="flex flex-col gap-1">
                    <label className="text-xs text-muted-foreground">To</label>
                    <input type="date" value={filterEnd} onChange={(e) => setFilterEnd(e.target.value)}
                      className="h-9 rounded-md border border-input bg-background px-3 text-sm" />
                  </div>
                  <Select value={filterStatus || 'all'} onValueChange={(val) => setFilterStatus(val === 'all' ? '' : val)}>
                    <SelectTrigger className="w-36 h-9">
                      <SelectValue placeholder="All statuses" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">All</SelectItem>
                      <SelectItem value="present">Present</SelectItem>
                      <SelectItem value="late">Late</SelectItem>
                      <SelectItem value="absent">Absent</SelectItem>
                      <SelectItem value="excused">Excused</SelectItem>
                    </SelectContent>
                  </Select>
                  <Button size="sm" onClick={loadDashboard} disabled={dashLoading} className="gap-1.5">
                    <RefreshCw className={`size-4 ${dashLoading ? 'animate-spin' : ''}`} />
                    Apply
                  </Button>
                  <Button size="sm" variant="ghost" onClick={() => { setFilterStart(''); setFilterEnd(''); setFilterStatus(''); }}>
                    Reset
                  </Button>
                </div>
              </CardContent>
            </Card>

            {/* Charts */}
            {dashData && (
              <div className="grid gap-4 lg:grid-cols-2">
                {/* Line chart — daily trend */}
                <Card>
                  <CardHeader className="pb-2 pt-4">
                    <CardTitle className="text-sm">Daily Trend (last 30 days)</CardTitle>
                  </CardHeader>
                  <CardContent className="pb-4">
                    <ResponsiveContainer width="100%" height={200}>
                      <LineChart data={dashData.dailyTrend} margin={{ top: 5, right: 10, left: -20, bottom: 0 }}>
                        <CartesianGrid strokeDasharray="3 3" className="stroke-border" />
                        <XAxis dataKey="date" tick={{ fontSize: 10 }}
                          tickFormatter={(d) => d.slice(5)} />
                        <YAxis tick={{ fontSize: 10 }} />
                        <ReTooltip />
                        <Legend wrapperStyle={{ fontSize: 11 }} />
                        <Line type="monotone" dataKey="present" stroke="#22c55e" strokeWidth={2} dot={false} />
                        <Line type="monotone" dataKey="late"    stroke="#f97316" strokeWidth={2} dot={false} />
                        <Line type="monotone" dataKey="absent"  stroke="#ef4444" strokeWidth={2} dot={false} />
                      </LineChart>
                    </ResponsiveContainer>
                  </CardContent>
                </Card>

                {/* Pie chart — distribution */}
                <Card>
                  <CardHeader className="pb-2 pt-4">
                    <CardTitle className="text-sm">Status Distribution</CardTitle>
                  </CardHeader>
                  <CardContent className="pb-4 flex items-center justify-center">
                    <ResponsiveContainer width="100%" height={200}>
                      <PieChart>
                        <Pie
                          data={Object.entries(dashData.distribution).map(([name, value]) => ({ name, value }))}
                          cx="50%" cy="50%" outerRadius={70}
                          dataKey="value" label={({ name, percent }) => percent > 0.05 ? `${name} ${(percent * 100).toFixed(0)}%` : ''}
                          labelLine={false}
                        >
                          {Object.keys(dashData.distribution).map((key) => (
                            <Cell key={key} fill={PIE_COLORS[key] ?? '#94a3b8'} />
                          ))}
                        </Pie>
                        <ReTooltip />
                      </PieChart>
                    </ResponsiveContainer>
                  </CardContent>
                </Card>
              </div>
            )}
          </TabsContent>

          {/* ================================================================
              TAB 2 — RECORDS
          ================================================================ */}
          <TabsContent value="records" className="space-y-4 mt-4">

            {/* Date Selection */}
            <Card>
              <CardHeader className="pb-3 pt-4">
                <CardTitle className="text-sm">Pick a Date</CardTitle>
              </CardHeader>
              <CardContent className="px-3 pb-4">
                <input
                  type="date"
                  value={selectedDate || ''}
                  onChange={(e) => setSelectedDate(e.target.value || null)}
                  className="h-10 rounded-lg border border-input bg-background px-3 text-sm w-full sm:w-48 focus:ring-2 focus:ring-primary focus:outline-none"
                />
              </CardContent>
            </Card>

            {/* Day view with Morning/Afternoon separation */}
            {selectedDate && (
              <div className="space-y-4">
                {/* Header */}
                <div className="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-between">
                  <div>
                    <h2 className="text-lg font-semibold flex items-center gap-2">
                      <Calendar className="size-5 text-primary" />
                      {new Date(selectedDate + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
                    </h2>
                    {dayData && (
                      <p className="text-xs text-muted-foreground mt-1">
                        {dayData.records.length} records • {dayData.noRecord.length} missing
                      </p>
                    )}
                  </div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <Input
                      placeholder="Search trainee…"
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      className="h-9 w-40 text-sm"
                      aria-label="Search trainee"
                    />
                    <Button
                      variant={viewMode === 'card' ? 'default' : 'outline'}
                      size="icon" className="size-9"
                      onClick={() => setViewMode('card')}
                      title="Card view"
                    >
                      <LayoutGrid className="size-4" />
                    </Button>
                    <Button
                      variant={viewMode === 'table' ? 'default' : 'outline'}
                      size="icon" className="size-9"
                      onClick={() => setViewMode('table')}
                      title="Table view"
                    >
                      <List className="size-4" />
                    </Button>
                  </div>
                </div>

                {dayLoading ? (
                  <div className="grid gap-3 grid-cols-1 sm:grid-cols-2">
                    {[...Array(4)].map((_, i) => <Skeleton key={i} className="h-48 rounded-xl" />)}
                  </div>
                ) : viewMode === 'card' ? (
                  /* ── CARD VIEW ── */
                  <div className="grid gap-6 grid-cols-1">
                    {/* Morning Section */}
                    <div>
                      <h3 className="text-base font-semibold mb-3 flex items-center gap-2">
                        <div className="size-8 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                          <span className="text-lg">🌅</span>
                        </div>
                        Morning Check-In
                      </h3>
                      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {filteredRecords
                          .filter(r => r.morning_time_in || r.check_in_time)
                          .map((r) => {
                            const t = r.trainee as any;
                            return (
                              <button
                                key={`morning-${r.id}`}
                                onClick={() => openModal(r, t)}
                                className="text-left rounded-lg border p-4 hover:shadow-md hover:border-primary/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary bg-amber-50/50 dark:bg-amber-950/10"
                              >
                                <div className="flex items-start gap-3">
                                  {t?.photo_path ? (
                                    <img src={getFileUrl(t.photo_path)} alt="" className="size-12 rounded-full object-cover flex-shrink-0" />
                                  ) : (
                                    <div className="size-12 rounded-full bg-primary/10 flex items-center justify-center text-sm font-bold text-primary flex-shrink-0">
                                      {t?.first_name?.[0]}{t?.last_name?.[0]}
                                    </div>
                                  )}
                                  <div className="flex-1 min-w-0">
                                    <p className="font-semibold text-sm truncate">{t?.first_name} {t?.last_name}</p>
                                    <div className="flex items-center gap-2 mt-1">
                                      <span className={`text-xs px-2 py-1 rounded-full ${STATUS_BADGE[r.status] ?? ''}`}>{r.status}</span>
                                      {r.late_duration_minutes && r.late_duration_minutes > 0 && (
                                        <span className="text-xs font-medium text-orange-600">Late {r.late_duration_minutes}m</span>
                                      )}
                                    </div>
                                  </div>
                                </div>
                                <div className="mt-3 space-y-1.5 text-xs">
                                  <div className="flex justify-between text-muted-foreground">
                                    <span>Check-in</span>
                                    <span className="font-medium text-foreground">{formatTime(r.morning_time_in ?? r.check_in_time)}</span>
                                  </div>
                                  <div className="flex items-center gap-1.5 pt-1 border-t">
                                    {r.selfie_morning_path && <Camera className="size-3.5 text-green-600" title="Selfie submitted" />}
                                    {r.gps_lat != null && <MapPin className="size-3.5 text-blue-600" title="GPS recorded" />}
                                  </div>
                                </div>
                              </button>
                            );
                          })}
                      </div>
                    </div>

                    {/* Afternoon Section */}
                    <div>
                      <h3 className="text-base font-semibold mb-3 flex items-center gap-2">
                        <div className="size-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                          <span className="text-lg">🌆</span>
                        </div>
                        Afternoon Check-Out
                      </h3>
                      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {filteredRecords
                          .filter(r => r.afternoon_time_out || r.check_out_time)
                          .map((r) => {
                            const t = r.trainee as any;
                            return (
                              <button
                                key={`afternoon-${r.id}`}
                                onClick={() => openModal(r, t)}
                                className="text-left rounded-lg border p-4 hover:shadow-md hover:border-primary/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary bg-indigo-50/50 dark:bg-indigo-950/10"
                              >
                                <div className="flex items-start gap-3">
                                  {t?.photo_path ? (
                                    <img src={getFileUrl(t.photo_path)} alt="" className="size-12 rounded-full object-cover flex-shrink-0" />
                                  ) : (
                                    <div className="size-12 rounded-full bg-primary/10 flex items-center justify-center text-sm font-bold text-primary flex-shrink-0">
                                      {t?.first_name?.[0]}{t?.last_name?.[0]}
                                    </div>
                                  )}
                                  <div className="flex-1 min-w-0">
                                    <p className="font-semibold text-sm truncate">{t?.first_name} {t?.last_name}</p>
                                    <div className="flex items-center gap-2 mt-1">
                                      <span className={`text-xs px-2 py-1 rounded-full ${STATUS_BADGE[r.status] ?? ''}`}>{r.status}</span>
                                    </div>
                                  </div>
                                </div>
                                <div className="mt-3 space-y-1.5 text-xs">
                                  <div className="flex justify-between text-muted-foreground">
                                    <span>Check-out</span>
                                    <span className="font-medium text-foreground">{formatTime(r.afternoon_time_out ?? r.check_out_time)}</span>
                                  </div>
                                  <div className="flex items-center gap-1.5 pt-1 border-t">
                                    {r.selfie_afternoon_path && <Camera className="size-3.5 text-green-600" title="Selfie submitted" />}
                                    {r.gps_lat != null && <MapPin className="size-3.5 text-blue-600" title="GPS recorded" />}
                                  </div>
                                </div>
                              </button>
                            );
                          })}
                      </div>
                    </div>

                    {/* Missing Records */}
                    {filteredNoRecord.length > 0 && (
                      <div>
                        <h3 className="text-base font-semibold mb-3 flex items-center gap-2 text-red-600">
                          <div className="size-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                            <span className="text-lg">❌</span>
                          </div>
                          No Attendance Record
                        </h3>
                        <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                          {filteredNoRecord.map((t: any) => (
                            <button
                              key={t.id}
                              onClick={() => openModal(null, t)}
                              className="text-left rounded-lg border border-dashed p-4 hover:shadow-md transition-all focus:outline-none focus:ring-2 focus:ring-primary bg-red-50/30 dark:bg-red-950/10 opacity-75"
                            >
                              <div className="flex items-start gap-3">
                                <div className="size-12 rounded-full bg-muted flex items-center justify-center text-sm font-bold text-muted-foreground flex-shrink-0">
                                  {t.first_name?.[0]}{t.last_name?.[0]}
                                </div>
                                <div className="flex-1 min-w-0">
                                  <p className="font-semibold text-sm truncate">{t.first_name} {t.last_name}</p>
                                  <p className="text-xs text-muted-foreground mt-1">No record submitted</p>
                                </div>
                              </div>
                            </button>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                ) : (
                  /* ── TABLE VIEW ── */
                  <div className="space-y-6">
                    {/* Morning Table */}
                    <div>
                      <h3 className="text-base font-semibold mb-3 flex items-center gap-2">
                        <div className="size-6 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                          <span>🌅</span>
                        </div>
                        Morning Check-In
                      </h3>
                      <div className="overflow-x-auto rounded-lg border">
                        <table className="w-full text-sm">
                          <thead className="bg-muted/50">
                            <tr>
                              {['Trainee', 'Status', 'Time', 'Late', 'Selfie', 'GPS'].map((h) => (
                                <th key={h} className="text-left px-3 py-2 text-xs font-semibold text-muted-foreground">{h}</th>
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {filteredRecords
                              .filter(r => r.morning_time_in || r.check_in_time)
                              .map((r) => {
                                const t = r.trainee as any;
                                return (
                                  <tr key={`tbl-morning-${r.id}`} className="border-b hover:bg-muted/30 cursor-pointer" onClick={() => openModal(r, t)}>
                                    <td className="px-3 py-2 font-medium">{t?.first_name} {t?.last_name}</td>
                                    <td className="px-3 py-2">
                                      <span className={`text-xs px-2 py-1 rounded-full ${STATUS_BADGE[r.status] ?? ''}`}>{r.status}</span>
                                    </td>
                                    <td className="px-3 py-2 tabular-nums">{formatTime(r.morning_time_in ?? r.check_in_time)}</td>
                                    <td className="px-3 py-2 text-orange-600">{r.late_duration_minutes ? `${r.late_duration_minutes}m` : '—'}</td>
                                    <td className="px-3 py-2">{r.selfie_morning_path ? <Camera className="size-4 text-green-600" /> : '—'}</td>
                                    <td className="px-3 py-2">{r.gps_lat != null ? <MapPin className="size-4 text-blue-600" /> : '—'}</td>
                                  </tr>
                                );
                              })}
                          </tbody>
                        </table>
                      </div>
                    </div>

                    {/* Afternoon Table */}
                    <div>
                      <h3 className="text-base font-semibold mb-3 flex items-center gap-2">
                        <div className="size-6 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                          <span>🌆</span>
                        </div>
                        Afternoon Check-Out
                      </h3>
                      <div className="overflow-x-auto rounded-lg border">
                        <table className="w-full text-sm">
                          <thead className="bg-muted/50">
                            <tr>
                              {['Trainee', 'Status', 'Time', 'Selfie', 'GPS'].map((h) => (
                                <th key={h} className="text-left px-3 py-2 text-xs font-semibold text-muted-foreground">{h}</th>
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {filteredRecords
                              .filter(r => r.afternoon_time_out || r.check_out_time)
                              .map((r) => {
                                const t = r.trainee as any;
                                return (
                                  <tr key={`tbl-afternoon-${r.id}`} className="border-b hover:bg-muted/30 cursor-pointer" onClick={() => openModal(r, t)}>
                                    <td className="px-3 py-2 font-medium">{t?.first_name} {t?.last_name}</td>
                                    <td className="px-3 py-2">
                                      <span className={`text-xs px-2 py-1 rounded-full ${STATUS_BADGE[r.status] ?? ''}`}>{r.status}</span>
                                    </td>
                                    <td className="px-3 py-2 tabular-nums">{formatTime(r.afternoon_time_out ?? r.check_out_time)}</td>
                                    <td className="px-3 py-2">{r.selfie_afternoon_path ? <Camera className="size-4 text-green-600" /> : '—'}</td>
                                    <td className="px-3 py-2">{r.gps_lat != null ? <MapPin className="size-4 text-blue-600" /> : '—'}</td>
                                  </tr>
                                );
                              })}
                          </tbody>
                        </table>
                      </div>
                    </div>

                    {/* Missing Records Table */}
                    {filteredNoRecord.length > 0 && (
                      <div>
                        <h3 className="text-base font-semibold mb-3 flex items-center gap-2 text-red-600">
                          <span>❌</span> No Attendance Record
                        </h3>
                        <div className="overflow-x-auto rounded-lg border">
                          <table className="w-full text-sm">
                            <thead className="bg-muted/50">
                              <tr>
                                <th className="text-left px-3 py-2 text-xs font-semibold text-muted-foreground">Trainee</th>
                              </tr>
                            </thead>
                            <tbody>
                              {filteredNoRecord.map((t: any) => (
                                <tr key={t.id} className="border-b hover:bg-muted/30 cursor-pointer opacity-75" onClick={() => openModal(null, t)}>
                                  <td className="px-3 py-2 font-medium">{t.first_name} {t.last_name}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )}
                  </div>
                )}
              </div>
            )}
          </TabsContent>

          {/* ================================================================
              TAB 3 — SCHEDULES  (full CRUD with ScheduleFormModal)
          ================================================================ */}
          <TabsContent value="schedules" className="mt-4">
            {canOverride && (
              <div className="flex justify-between items-center mb-4">
                <p className="text-xs text-muted-foreground">
                  Only one schedule can be active at a time. Activating one will deactivate others.
                </p>
                <Button
                  size="sm"
                  onClick={() => { setEditingSchedule(undefined); setScheduleFormOpen(true); }}
                  className="gap-1.5"
                  aria-label="Create schedule"
                >
                  + Create Schedule
                </Button>
              </div>
            )}
            {schedulesLoading ? (
              <div className="space-y-3">
                {[...Array(3)].map((_, i) => <Skeleton key={i} className="h-32 w-full rounded-xl" />)}
              </div>
            ) : schedules.length === 0 ? (
              <Card className="border-dashed border-2">
                <CardContent className="py-10 px-6">
                  <div className="max-w-md mx-auto space-y-5 text-center">
                    {/* Icon + heading */}
                    <div className="flex size-14 items-center justify-center rounded-2xl bg-primary/10 mx-auto">
                      <Clock className="size-7 text-primary" />
                    </div>
                    <div>
                      <p className="text-base font-semibold">No attendance schedule yet</p>
                      <p className="text-sm text-muted-foreground mt-1">
                        Trainees can't check in until a schedule is active. It only takes a minute to set one up.
                      </p>
                    </div>

                    {/* How it works steps */}
                    <div className="text-left space-y-2.5">
                      {[
                        { step: '1', label: 'Create a schedule', desc: 'Set morning and afternoon check-in windows and choose a late threshold.' },
                        { step: '2', label: 'Activate it', desc: 'Click Activate on the schedule card. Only one can be active at a time.' },
                        { step: '3', label: 'Trainees check in', desc: 'The Take Attendance button appears on their calendar during the active window.' },
                      ].map(({ step, label, desc }) => (
                        <div key={step} className="flex items-start gap-3">
                          <div className="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground text-xs font-bold mt-0.5">
                            {step}
                          </div>
                          <div>
                            <p className="text-sm font-medium">{label}</p>
                            <p className="text-xs text-muted-foreground">{desc}</p>
                          </div>
                        </div>
                      ))}
                    </div>

                    {canOverride && (
                      <Button
                        onClick={() => { setEditingSchedule(undefined); setScheduleFormOpen(true); }}
                        className="gap-2 w-full sm:w-auto"
                        size="lg"
                      >
                        <Clock className="size-4" />
                        Create Attendance Schedule
                      </Button>
                    )}
                  </div>
                </CardContent>
              </Card>
            ) : (
              <div className="space-y-3">
                {schedules.map((s) => (
                  <Card key={s.id}>
                    <CardContent className="pt-4 pb-4">
                      <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                        <div className="space-y-1">
                          <div className="flex items-center gap-2 flex-wrap">
                            <p className="font-semibold text-sm">{s.name}</p>
                            <Badge
                              className={s.status === 'active'
                                ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 border-0'
                                : s.status === 'archived'
                                ? 'bg-muted text-muted-foreground border-0'
                                : 'bg-secondary text-secondary-foreground border-0'}
                            >
                              {s.status}
                            </Badge>
                          </div>
                          <p className="text-xs text-muted-foreground">
                            {s.effective_date_start} → {s.effective_date_end}
                          </p>
                          <p className="text-xs text-muted-foreground">
                            ☀ Morning: {s.morning_open} – {s.morning_close} (late after {s.morning_late_threshold}min)
                            &nbsp;·&nbsp;
                            🌙 Afternoon: {s.afternoon_open} – {s.afternoon_close} (late after {s.afternoon_late_threshold}min)
                          </p>
                        </div>
                        {canOverride && s.status !== 'archived' && (
                          <div className="flex gap-2 flex-wrap shrink-0">
                            {s.status === 'active' ? (
                              <Button size="sm" variant="outline"
                                onClick={async () => {
                                  try { await attendanceService.deactivateSchedule(s.id); loadSchedules(); toast.success('Deactivated'); }
                                  catch { toast.error('Failed to deactivate'); }
                                }}
                              >Deactivate</Button>
                            ) : (
                              <Button size="sm"
                                onClick={async () => {
                                  try { await attendanceService.activateSchedule(s.id); loadSchedules(); toast.success('Activated'); }
                                  catch { toast.error('Failed to activate'); }
                                }}
                              >Activate</Button>
                            )}
                            <Button size="sm" variant="outline"
                              aria-label="Edit schedule"
                              onClick={() => { setEditingSchedule(s); setScheduleFormOpen(true); }}
                            >Edit</Button>
                            <Button size="sm" variant="outline"
                              aria-label="Add date override"
                              onClick={() => {
                                setOverrideScheduleId(s.id);
                                setOverrideSchedule(s);
                                setOverrideModalOpen(true);
                              }}
                            >+ Override</Button>
                            <Button size="sm" variant="ghost" className="text-destructive hover:bg-destructive/10"
                              aria-label="Archive schedule"
                              onClick={async () => {
                                if (!confirm('Archive this schedule?')) return;
                                try { await attendanceService.archiveSchedule(s.id); loadSchedules(); toast.success('Archived'); }
                                catch { toast.error('Failed to archive'); }
                              }}
                            >Archive</Button>
                          </div>
                        )}
                      </div>
                    </CardContent>
                  </Card>
                ))}
              </div>
            )}
          </TabsContent>

        </Tabs>
      </div>

      {/* ── Detail modal ── */}
      <AttendanceDetailModal
        record={modalRecord}
        trainee={modalTrainee}
        programName={program?.name}
        isOpen={modalOpen}
        onClose={() => setModalOpen(false)}
        onStatusUpdated={() => {
          if (selectedDate && programId) {
            attendanceService.getDayAttendance(programId, selectedDate)
              .then((res) => setDayData(res.data ?? null))
              .catch(() => {});
          }
        }}
        canOverride={canOverride}
      />

      {/* ── Schedule form modal ── */}
      {programId && (
        <ScheduleFormModal
          isOpen={scheduleFormOpen}
          onClose={() => { setScheduleFormOpen(false); setEditingSchedule(undefined); }}
          onSaved={loadSchedules}
          programId={programId}
          schedule={editingSchedule}
          programStartDate={toDateString(program?.start_date)}
          programEndDate={toDateString(program?.end_date)}
        />
      )}

      {/* ── Override modal ── */}
      <ScheduleOverrideModal
        isOpen={overrideModalOpen}
        onClose={() => setOverrideModalOpen(false)}
        onSaved={loadSchedules}
        scheduleId={overrideScheduleId}
        effectiveDateStart={overrideSchedule?.effective_date_start}
        effectiveDateEnd={overrideSchedule?.effective_date_end}
      />
    </DashboardLayout>
  );
}
